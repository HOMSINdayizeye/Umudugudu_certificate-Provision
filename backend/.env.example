# ---- Local development (copy to .env) ----
SECRET_KEY=change-me
DEBUG=True
DB_NAME=certify
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Production on Vercel (set these in the Vercel project → Settings → Environment Variables) ----
# SECRET_KEY=<long random string>
# DEBUG=False
# DATABASE_URL=postgresql://user:password@host:5432/dbname          # Neon / Supabase / Railway…
# ALLOWED_HOSTS=api.yourdomain.rw                                    # *.vercel.app is always allowed
# CORS_ALLOWED_ORIGINS=https://certify-frontend.vercel.app           # your frontend URL(s), comma-separated
# CSRF_TRUSTED_ORIGINS=https://api.yourdomain.rw                     # only if you use a custom API domain
#
# Object storage for uploads and generated letters (Vercel has no persistent disk).
# Any S3-compatible service works: Supabase Storage, Cloudflare R2, AWS S3, MinIO.
# STORAGE_BUCKET=certify-files
# STORAGE_ACCESS_KEY=...
# STORAGE_SECRET_KEY=...
# STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3      # leave empty for AWS S3
# STORAGE_REGION=auto

# ---- Brevo: password-reset emails and SMS (local .env or the hosting platform's environment variables) ----
# Brevo → your name (top right) → SMTP & API → API Keys → Generate a new API key (starts with xkeysib-)
# BREVO_API_KEY=xkeysib-...
# Address the emails come from; add and verify it under Brevo → Senders & IP → Senders
# BREVO_EMAIL_SENDER=no-reply@kigalicity.gov.rw
# BREVO_EMAIL_SENDER_NAME=Certify
# Only for accounts without an email (needs SMS credits); max 11 letters/digits
# BREVO_SMS_SENDER=Certify
# Where the link in the reset email points; leave unset locally, set to the deployed frontend in production
# FRONTEND_URL=https://certify-frontend.vercel.app
